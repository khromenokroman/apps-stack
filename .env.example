# Скопировать в .env и поправить: docker compose читает .env из каталога с docker-compose.yml.

# адрес хоста для всех портов: 0.0.0.0 - из сети, 127.0.0.1 - только с этой машины (например, за прокси)
LISTEN_ADDR=0.0.0.0

ARENDA_PORT=8080
BAKERY_PORT=8081
PRICE_TAGS_PORT=8082
TSG_BILLING_PORT=8083

# часовой пояс: даты документов и время копий по расписанию (03:00) в arenda и bakery
TZ=Europe/Kaliningrad

# версии образов: latest или конкретная, например ARENDA_TAG=0.18.0.0 (список на странице пакета в GHCR)
ARENDA_TAG=latest
BAKERY_TAG=latest
PRICE_TAGS_TAG=latest
TSG_BILLING_TAG=latest
